# ═══════════════════════════════════════════════════════════
# SunuBot — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ═══════════════════════════════════════════════════════════

# === Base de donnees PostgreSQL ===
DATABASE_URL="postgresql://postgres:VOTRE_MDP@localhost:5433/sunubot"

# === JWT Secret ===
JWT_SECRET="sunubot-secret-m2-ia-2024-thies"

# === LLM Mistral (obligatoire pour mode 1 et 2) ===
MISTRAL_API_KEY="votre-cle-mistral"
MISTRAL_MODEL="mistral-small-latest"

# === Admin Dashboard ===
ADMIN_PASSWORD="admin2024"

# === Email SMTP (optionnel — mode simulation si absent) ===
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="votre@gmail.com"
# SMTP_PASS="votre-app-password"

# === WhatsApp Meta Cloud API (optionnel — mode simulation si absent) ===
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
# WHATSAPP_VERIFY_TOKEN="sunubot-webhook-2024"

# === Ports (pour reference) ===
# Frontend Next.js : 5001
# Backend NLP Python : 8000
# PostgreSQL : 5433
