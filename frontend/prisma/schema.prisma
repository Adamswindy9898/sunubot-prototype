generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Citoyen {
  id                String    @id @default(cuid())
  numero_acte       String    @unique
  nom               String
  prenom            String
  date_naissance    String
  lieu_naissance    String
  nom_pere          String
  nom_mere          String
  telephone         String?
  commune           String    @default("Commune de Thiès")
  centre_etat_civil String    @default("Centre d'état civil de Thiès")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  demandes          Demande[]

  @@map("citoyens")
}

model Compte {
  id              String    @id @default(cuid())
  nom             String
  prenom          String
  email           String    @unique
  telephone       String
  passwordHash    String
  dateInscription String
  numeroActe      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  demandes        Demande[]
  sessions        Session[]

  @@map("comptes")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  compteId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  compte    Compte   @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Demande {
  id            String   @id @default(cuid())
  reference     String   @unique
  type          String
  service       String
  statut        String   @default("RECU")
  details       String   @default("{}")
  dateCreation  String
  dateMiseAJour String
  compteId      String?
  citoyenId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  citoyen       Citoyen? @relation(fields: [citoyenId], references: [id])
  compte        Compte?  @relation(fields: [compteId], references: [id])

  @@map("demandes")
}

model ServiceRecord {
  id        String   @id @default(cuid())
  type      String
  reference String   @unique
  nom       String
  prenom    String
  telephone String?
  data      String
  statut    String   @default("actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_records")
}

model ConversationLog {
  id        String   @id @default(cuid())
  message   String
  langue    String
  intent    String?
  domaine   String?
  compteId  String?
  ip        String?
  createdAt DateTime @default(now())

  @@map("conversation_logs")
}

model Satisfaction {
  id          String   @id @default(cuid())
  nps         Int
  mos         Int
  commentaire String?
  langue      String   @default("francais")
  service     String?
  compteId    String?
  ip          String?
  createdAt   DateTime @default(now())

  @@map("satisfactions")
}

model AccessLog {
  id        String   @id @default(cuid())
  action    String
  method    String
  path      String
  ip        String?
  userAgent String?
  statut    Int
  compteId  String?
  createdAt DateTime @default(now())

  @@map("access_logs")
}
